# Local development — copy this to .env
# DATABASE_URL uses localhost (not "db") because the app runs on the host, not in Docker
DATABASE_URL="postgresql://ticnexus:changeme@localhost:5432/ticnexus"
POSTGRES_USER=ticnexus
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ticnexus

NEXT_PUBLIC_APP_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"

# Generate a real secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"

# Gmail (not required for local development)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Discord webhooks — paste the webhook URL for each department channel
# Leave blank to disable notifications for that department
DISCORD_WEBHOOK_IT=""
DISCORD_WEBHOOK_MAINTENANCE=""
