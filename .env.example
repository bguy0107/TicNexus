# Database
DATABASE_URL="postgresql://ticnexus:changeme@db:5432/ticnexus"
POSTGRES_USER=ticnexus
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ticnexus

# App
# Both URLs must exactly match the origin the browser uses to reach the app,
# including the port if it is not the default for the scheme (80 for http, 443
# for https). Better-Auth validates the request origin against BETTER_AUTH_URL
# and will reject sign-in attempts when there is a mismatch.
#
# Examples:
#   Behind a reverse proxy on port 80/443 : http://192.168.1.10
#   Direct Docker Compose on port 3000    : http://192.168.1.10:3000
#   Production with TLS                   : https://app.example.com
NEXT_PUBLIC_APP_URL="http://yourdomain.com"
BETTER_AUTH_URL="http://yourdomain.com"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"

# Gmail — use an App Password, not your account password
# Enable 2FA on your Google account, then create an App Password at:
# https://myaccount.google.com/apppasswords
GMAIL_USER="you@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Discord webhooks — paste the webhook URL for each department channel
# Leave blank to disable notifications for that department
DISCORD_WEBHOOK_IT=""
DISCORD_WEBHOOK_MAINTENANCE=""
