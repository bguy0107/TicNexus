generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  FRANCHISE_MANAGER
  SUPERVISOR
  TECHNICIAN
  STORE_USER
}

enum Department {
  IT
  MAINTENANCE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  INVITE_SENT
  INVITE_ACCEPTED
  DEACTIVATE
  REACTIVATE
  PASSWORD_RESET
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  ORDERED
  MONITORING
  AWAITING_APPROVAL
  APPROVED
  PROJECTED
  CLOSED
}

enum FootageRequestStatus {
  PENDING
  FULFILLED
  DENIED
}

enum RequestingParty {
  LAW_ENFORCEMENT
  INTERNAL
}

// ── better-auth required tables ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Custom fields
  firstName     String     @default("")
  lastName      String     @default("")
  role          Role       @default(STORE_USER)
  departments   Department[]  @default([])
  deletedAt           DateTime?
  createdById         String?
  mustChangePassword  Boolean   @default(false)
  phone               String?

  // Relations
  sessions         Session[]
  accounts         Account[]
  userFranchises   UserFranchise[]
  userLocations    UserLocation[]
  auditLogsAsActor AuditLog[]     @relation("AuditActor")
  invitationsSent  Invitation[]   @relation("InvitationSentBy")
  createdBy        User?          @relation("CreatedBy", fields: [createdById], references: [id])
  createdUsers     User[]         @relation("CreatedBy")
  ticketsCreated         Ticket[]         @relation("TicketCreator")
  ticketHistory          TicketHistory[]
  footageRequestsCreated FootageRequest[] @relation("FootageRequestCreator")
  footageRequestsResolved FootageRequest[] @relation("FootageRequestResolver")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                   String    @id @default(cuid())
  accountId            String
  providerId           String
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken          String?
  refreshToken         String?
  idToken              String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope                String?
  password             String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ── Application tables ───────────────────────────────────────────────────────

model Franchise {
  id                      String    @id @default(cuid())
  name                    String
  maintenanceCostLimit    Decimal?  @db.Decimal(10, 2)
  itCostLimit             Decimal?  @db.Decimal(10, 2)
  createdById             String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  deletedAt               DateTime?

  locations      Location[]
  userFranchises UserFranchise[]
  invitations    Invitation[]
}

model Location {
  id             String    @id @default(cuid())
  name           String
  locationNumber String
  address        String?
  franchiseId    String
  franchise   Franchise @relation(fields: [franchiseId], references: [id])
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  userLocations   UserLocation[]
  invitations     Invitation[]
  tickets         Ticket[]
  footageRequests FootageRequest[]
}

model UserFranchise {
  id           String    @id @default(cuid())
  userId       String
  franchiseId  String
  assignedById String?
  assignedAt   DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  franchise Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)

  @@unique([userId, franchiseId])
}

model UserLocation {
  id           String   @id @default(cuid())
  userId       String
  locationId   String
  assignedById String?
  assignedAt   DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId])
}

model Invitation {
  id          String      @id @default(cuid())
  email       String
  role        Role
  department  Department?
  token       String      @unique @default(cuid())
  franchiseId String?
  locationId  String?
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime    @default(now())

  franchise Franchise? @relation(fields: [franchiseId], references: [id])
  location  Location?  @relation(fields: [locationId], references: [id])
  invitedBy User       @relation("InvitationSentBy", fields: [invitedById], references: [id])
}

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String
  action     AuditAction
  entityType String
  entityId   String
  changes    Json?
  ipAddress  String?
  createdAt  DateTime    @default(now())

  actor User @relation("AuditActor", fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

model Ticket {
  id          String       @id @default(cuid())
  type        Department
  status      TicketStatus @default(OPEN)
  issue       String
  locationId  String
  deadline    DateTime?
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  location  Location        @relation(fields: [locationId], references: [id])
  createdBy User            @relation("TicketCreator", fields: [createdById], references: [id])
  history   TicketHistory[]

  @@index([locationId])
  @@index([createdById])
  @@index([status])
}

model TicketHistory {
  id          String       @id @default(cuid())
  ticketId    String
  userId      String
  comment     String?
  attachment  String?
  statusFrom  TicketStatus?
  statusTo    TicketStatus?
  cost        Decimal?     @db.Decimal(10, 2)
  createdAt   DateTime     @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([ticketId])
}

model FootageRequest {
  id              String               @id @default(cuid())
  locationId      String
  startDateTime   DateTime
  endDateTime     DateTime
  cameraArea      String
  requestingParty  RequestingParty
  officerName      String?
  internalContact  String?
  status           FootageRequestStatus @default(PENDING)
  resolutionNote  String?
  resolvedById    String?
  resolvedAt      DateTime?
  createdById     String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  location   Location @relation(fields: [locationId], references: [id])
  createdBy  User     @relation("FootageRequestCreator", fields: [createdById], references: [id])
  resolvedBy User?    @relation("FootageRequestResolver", fields: [resolvedById], references: [id])

  @@index([locationId])
  @@index([createdById])
  @@index([status])
}
